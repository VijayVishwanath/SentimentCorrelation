# Copy to .env and adjust. All DEX_* settings are optional.
DEX_ENVIRONMENT=production
DEX_LOG_LEVEL=INFO

# Database (SQLite by default; any SQLAlchemy URL, e.g. postgresql+psycopg://user:pass@host/db)
# DEX_DATABASE_URL=sqlite:///data/dex_sentinel.db

# Require X-API-Key on every /api/v1 call (recommended outside a laptop demo)
# DEX_API_KEY=change-me

# Replace employee names with pseudonyms (Employee 0001 ...)
DEX_MASK_PII=false

# DEX Copilot provider: auto | anthropic | azure_openai | template
DEX_LLM_PROVIDER=auto
# Claude (default when set)
# ANTHROPIC_API_KEY=
# DEX_ANTHROPIC_MODEL=claude-opus-5-5
# DEX_ANTHROPIC_EFFORT=medium
# Azure OpenAI (alternative)
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
