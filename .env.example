# Copy to .env and adjust. All DEX_* settings are optional.
DEX_ENVIRONMENT=production
DEX_LOG_LEVEL=INFO

# Database (SQLite by default; any SQLAlchemy URL, e.g. postgresql+psycopg://user:pass@host/db)
# DEX_DATABASE_URL=sqlite:///data/dex_sentinel.db

# Require X-API-Key on every /api/v1 call (recommended outside a laptop demo)
# DEX_API_KEY=change-me

# Replace employee names with pseudonyms (Employee 0001 ...)
DEX_MASK_PII=false

# DEX Copilot provider: auto | anthropic | azure_openai | template
DEX_LLM_PROVIDER=auto
# Claude (default when set)
# ANTHROPIC_API_KEY=
# DEX_ANTHROPIC_MODEL=claude-opus-5-5
# DEX_ANTHROPIC_EFFORT=medium
# Azure OpenAI (alternative)
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=

# Software-remediation MCP server (docs/REMEDIATION_MCP.md). Removal runs on the simulated fleet only.
# DEX_REMEDIATION_ALLOWED_SENDERS=["security-team@company.com","it-compliance@company.com"]
# DEX_REMEDIATION_SERVICE_ACCOUNT=svc_software_removal
# DEX_REMEDIATION_TOKEN_TTL_SEC=1800
# DEX_REMEDIATION_SEED_INBOX=true
# Optional real mailbox, polled read-only by email_monitor(action="poll")
# DEX_IMAP_HOST=outlook.office365.com
# DEX_IMAP_PORT=993
# DEX_IMAP_USERNAME=dex-remediation@company.com
# DEX_IMAP_PASSWORD=
# DEX_IMAP_FOLDER=INBOX